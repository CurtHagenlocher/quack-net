// part: metadata

[setup]
drop = "test_array"

[tags]
sql-type-name = "INTEGER[2]"

// part: setup_query

CREATE TABLE test_array (idx INTEGER, res INTEGER[2]);
INSERT INTO test_array VALUES
    (0, [NULL,NULL]),
    (1, [-2147483648,2147483647]),
    (2, NULL);

// part: query

SELECT res FROM test_array ORDER BY idx

// part: expected_schema

{
  "format": "+s",
  "children": [
    {
      "name": "res",
      "format": "+w:2",
      "flags": [
        "nullable"
      ],
      "children": [
        {
          "name": "",
          "format": "i",
          "flags": [
            "nullable"
          ]
        }
      ]
    }
  ]
}

// part: expected

{"res": [null, null]}
{"res": [-2147483648, 2147483647]}
{"res": null}
