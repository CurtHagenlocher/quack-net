// part: metadata

[setup]
drop = "test_char"

[tags]
sql-type-name = "CHAR"

// part: setup_query

CREATE TABLE test_char (idx INTEGER, res CHAR);
INSERT INTO test_char VALUES
    (0, ''),
    (1, 'x  '),
    (2, '日本語'),
    (3, NULL);

// part: query

SELECT res FROM test_char ORDER BY idx

// part: expected_schema

{"format":"+s","children":[{"name":"res","format":"u","flags":["nullable"]}]}

// part: expected

{"res": ""}
{"res": "x  "}
{"res": "日本語"}
{"res": null}
