// part: metadata

[tags]
sql-type-name = "ENUM"

// part: query

SELECT res FROM (VALUES
    (1, 'z'), (2, 'a'), (3, 'z'), (4, NULL)
) t(idx, label), LATERAL (SELECT label::ENUM('a', 'unused', 'z') AS res)
ORDER BY idx

// part: expected_schema

{
  "format": "+s",
  "children": [
    {
      "name": "res",
      "flags": [
        "nullable"
      ],
      "format": "u",
      "dictionary": {
        "indexType": "C",
        "isOrdered": false
      }
    }
  ]
}

// part: expected

{"res": "z"}
{"res": "a"}
{"res": "z"}
{"res": null}
