// part: metadata

[setup]
drop = "test_hugeint"

[tags]
sql-type-name = "HUGEINT"

// part: setup_query

CREATE TABLE test_hugeint (idx INTEGER, res HUGEINT);
INSERT INTO test_hugeint VALUES
    (0, '-99999999999999999999999999999999999999'),
    (2, '0'),
    (3, '99999999999999999999999999999999999999'),
    (5, NULL);

// part: query

SELECT res FROM test_hugeint ORDER BY idx

// part: expected_schema

{"format":"+s","children":[{"name":"res","format":"d:38,0","flags":["nullable"]}]}

// part: expected

{"res": "-99999999999999999999999999999999999999"}
{"res": "0"}
{"res": "99999999999999999999999999999999999999"}
{"res": null}
