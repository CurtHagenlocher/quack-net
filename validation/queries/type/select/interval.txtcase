// part: metadata

[setup]
drop = "test_interval"

[tags]
sql-type-name = "INTERVAL"

// part: setup_query

CREATE TABLE test_interval (idx INTEGER, res INTERVAL);
INSERT INTO test_interval VALUES
    (0, '0 seconds'),
    (1, '-2 months 3 days -4 microseconds'),
    (2, '9223372036854775 microseconds'),
    (3, to_microseconds('-9223372036854775808'::BIGINT)),
    (4, '9223372036854775807 microseconds'),
    (5, '-2147483648 months 2147483647 days'),
    (6, NULL);

// part: query

SELECT res FROM test_interval ORDER BY idx

// part: expected_schema

{"format":"+s","children":[{"name":"res","format":"tin","flags":["nullable"]}]}

// part: expected

{"res": "0M0d0ns"}
{"res": "-2M3d-4000ns"}
{"res": "0M0d9223372036854775000ns"}
{"res": "0M0d0ns"}
{"res": "0M0d-1000ns"}
{"res": "-2147483648M2147483647d0ns"}
{"res": null}
