// part: metadata

[setup]
drop = "test_list"

[tags]
sql-type-name = "STRUCT(a INTEGER)[]"

// part: setup_query

CREATE TABLE test_list (idx INTEGER, res STRUCT(a INTEGER)[]);
INSERT INTO test_list VALUES
    (0, []),
    (1, [{'a': -2147483648}, NULL, {'a': NULL}]),
    (2, NULL);

// part: query

SELECT res FROM test_list ORDER BY idx

// part: expected_schema

{
  "format": "+s",
  "children": [
    {
      "name": "res",
      "format": "+l",
      "flags": [
        "nullable"
      ],
      "children": [
        {
          "name": "l",
          "format": "+s",
          "flags": [
            "nullable"
          ],
          "children": [
            {
              "name": "a",
              "format": "i",
              "flags": [
                "nullable"
              ]
            }
          ]
        }
      ]
    }
  ]
}

// part: expected

{"res": []}
{"res": [{"a": -2147483648}, null, {"a": null}]}
{"res": null}
