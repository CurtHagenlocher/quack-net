// part: metadata

[setup]
drop = "test_struct"

[tags]
sql-type-name = "STRUCT(x INT, y VARCHAR)"

// part: setup_query

CREATE TABLE test_struct (idx INTEGER, res STRUCT(x INT, y VARCHAR));
INSERT INTO test_struct VALUES
    (0, {'x': NULL, 'y': ''}),
    (1, {'x': -5, 'y': NULL}),
    (2, NULL);

// part: query

SELECT res FROM test_struct ORDER BY idx

// part: expected_schema

{
  "format": "+s",
  "children": [
    {
      "name": "res",
      "format": "+s",
      "flags": [
        "nullable"
      ],
      "children": [
        {
          "name": "x",
          "format": "i",
          "flags": [
            "nullable"
          ]
        },
        {
          "name": "y",
          "format": "u",
          "flags": [
            "nullable"
          ]
        }
      ]
    }
  ]
}

// part: expected

{"res": {"x": null, "y": ""}}
{"res": {"x": -5, "y": null}}
{"res": null}
