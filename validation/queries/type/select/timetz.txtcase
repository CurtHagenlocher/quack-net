// part: metadata

[setup]
drop = "test_timetz"

[tags]
sql-type-name = "TIME WITH TIME ZONE"

// part: setup_query

CREATE TABLE test_timetz (idx INTEGER, res TIME WITH TIME ZONE);
INSERT INTO test_timetz VALUES
    (0, '00:00:00-12'),
    (1, '23:59:59.999999+14'),
    (2, '12:00:00+05'),
    (3, '12:00:00-05'),
    (4, NULL);

// part: query

SELECT res FROM test_timetz ORDER BY idx

// part: expected_schema

{"format":"+s","children":[{"name":"res","format":"ttu","flags":["nullable"]}]}

// part: expected

{"res": 0}
{"res": 86399999999}
{"res": 43200000000}
{"res": 43200000000}
{"res": null}
