// part: metadata

[setup]
drop = "test_uhugeint"

[tags]
sql-type-name = "UHUGEINT"

// part: setup_query

CREATE TABLE test_uhugeint (idx INTEGER, res UHUGEINT);
INSERT INTO test_uhugeint VALUES
    (0, '0'),
    (1, '99999999999999999999999999999999999999'),
    (2, '170141183460469231731687303715884105728'),
    (3, '340282366920938463463374607431768211455'),
    (4, NULL);

// part: query

SELECT res FROM test_uhugeint ORDER BY idx

// part: expected_schema

{"format":"+s","children":[{"name":"res","format":"d:38,0","flags":["nullable"]}]}

// part: expected

{"res": "0"}
{"res": "99999999999999999999999999999999999999"}
{"res": "-170141183460469231731687303715884105728"}
{"res": "-1"}
{"res": null}
