// part: metadata

[tags]
sql-type-name = "UNION"

// part: query

SELECT res FROM (VALUES
    (1, union_value(i := -2147483648)::UNION(i INTEGER, s VARCHAR)),
    (2, union_value(s := '雪')::UNION(i INTEGER, s VARCHAR)),
    (3, union_value(s := NULL::VARCHAR)::UNION(i INTEGER, s VARCHAR)),
    (4, NULL)
) t(idx, res) ORDER BY idx

// part: expected_schema

{
  "format": "+s",
  "children": [
    {
      "name": "res",
      "format": "+us:0,1",
      "children": [
        {
          "name": "i",
          "format": "i",
          "flags": [
            "nullable"
          ]
        },
        {
          "name": "s",
          "format": "u",
          "flags": [
            "nullable"
          ]
        }
      ]
    }
  ]
}

// part: expected

{"res": {"type_code": 0, "value": -2147483648}}
{"res": {"type_code": 1, "value": "雪"}}
{"res": {"type_code": 1, "value": null}}
{"res": {"type_code": 0, "value": null}}
